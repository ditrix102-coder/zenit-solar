---
---

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(12px);
    }
    :global(.dark) .glass-card {
        background: rgba(15, 23, 42, 0.95);
        border-color: rgba(255, 255, 255, 0.1);
    }
    :global(.dark) .glass-card label {
        color: #94a3b8;
    }
    :global(.dark) .glass-card input, 
    :global(.dark) .glass-card textarea,
    :global(.dark) .glass-card button#service-dropdown-btn {
        background-color: #1e293b;
        border-color: #334155;
        color: white;
    }
    :global(.dark) .glass-card #service-menu {
        background-color: #1e293b;
        border-color: #334155;
    }
    :global(.dark) .glass-card #service-menu div {
        color: white;
    }
    :global(.dark) .glass-card #service-menu div:hover {
        background-color: #334155;
    }
</style>

<!-- Divisor de sección -->
<div class="relative w-full h-12 md:h-24 bg-white dark:bg-[#020618] rounded-[100%_100%_0_0] shadow-[0_-10px_30px_rgba(255,159,0,0.15)] dark:shadow-[0_-10px_30px_rgba(255,159,0,0.2)] transition-colors"></div>

<section id="contacto" class="relative z-30 bg-white dark:bg-[#020618] pt-12 pb-24 transition-colors">
    
    <!-- Background glowing orbs -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-blue-600/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-emerald-600/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div data-aos="fade-up" class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4">
                ¿Necesitás <span class="text-emerald-500 dark:text-emerald-400">energía solar</span>?
            </h2>
            <p class="text-base text-slate-600 dark:text-slate-300">
                Comunicate con nosotros, te asesoramos sin compromiso
            </p>
        </div>

        <div data-aos="fade-up" data-aos-delay="200" class="w-full glass-card rounded-3xl shadow-2xl border border-slate-200/50 dark:border-slate-700 overflow-hidden">
            
            <div class="flex flex-col">
                
                <!-- Top Side: Interactive Contact Form -->
                <section class="p-6 sm:p-8 lg:p-10">
                    <form id="contact-form" novalidate onsubmit="handleFormSubmit(event)" class="space-y-5">
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="first-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                    Nombre <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                        <i class="fa-regular fa-user"></i>
                                    </div>
                                    <input type="text" id="first-name" placeholder="Ej. Juan" oninput="validateField(this)" onblur="validateField(this)"
                                        class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm transition-all duration-200">
                                </div>
                            </div>

                            <div>
                                <label for="last-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                    Apellido <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                        <i class="fa-regular fa-user"></i>
                                    </div>
                                    <input type="text" id="last-name" placeholder="Ej. Pérez" oninput="validateField(this)" onblur="validateField(this)"
                                        class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm transition-all duration-200">
                                </div>
                            </div>
                        </div>

                        <div>
                            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Correo Electrónico <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-regular fa-envelope"></i>
                                </div>
                                <input type="email" id="email" placeholder="tuemail@ejemplo.com" oninput="validateField(this)" onblur="validateField(this)"
                                    class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm transition-all duration-200">
                            </div>
                        </div>

                        <div>
                            <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Número de Celular / WhatsApp <span class="text-red-500">*</span>
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-brands fa-whatsapp text-lg text-emerald-600"></i>
                                </div>
                                <input type="tel" id="phone" placeholder="Ej: 2922 451282" oninput="validateField(this)" onblur="validateField(this)"
                                    class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm transition-all duration-200">
                            </div>
                            <div class="flex justify-between items-start mt-1.5 px-1 min-h-[20px]">
                                <p id="phone-hint" class="text-[11px] text-slate-500">Ejemplo: 2922 451282</p>
                                <p id="phone-error" class="hidden text-[11px] text-red-500 font-medium"></p>
                            </div>
                        </div>

                        <div class="relative">
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Seleccionar Servicio <span class="text-red-500">*</span>
                            </label>
                            
                            <!-- Toggle Button (Click to open / close) -->
                            <button type="button" id="service-dropdown-btn" onclick="toggleServiceDropdown()"
                                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-left flex items-center justify-between text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all cursor-pointer">
                                <span id="selected-service-text" class="font-medium flex items-center gap-2">
                                    <i class="fa-solid fa-home text-indigo-600"></i> Residencial
                                </span>
                                <i id="dropdown-arrow" class="fa-solid fa-chevron-down text-slate-400 transition-transform duration-200"></i>
                            </button>

                            <!-- Hidden Input for Form Data -->
                            <input type="hidden" id="selected-service" name="service" value="Residencial">

                            <!-- Dropdown Options Menu -->
                            <div id="service-menu" class="hidden absolute left-0 right-0 top-full mt-2 bg-white border border-slate-200 rounded-xl shadow-xl z-30 overflow-hidden divide-y divide-slate-100 transition-all">
                                <div onclick="selectService('Residencial', 'fa-home')" class="p-3.5 hover:bg-indigo-50 cursor-pointer flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700 transition-colors">
                                    <i class="fa-solid fa-home text-indigo-600 w-5 text-center"></i>
                                    <span>Residencial</span>
                                </div>
                                <div onclick="selectService('Comercial / Industrial', 'fa-industry')" class="p-3.5 hover:bg-indigo-50 cursor-pointer flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700 transition-colors">
                                    <i class="fa-solid fa-industry text-indigo-600 w-5 text-center"></i>
                                    <span>Comercial / Industrial</span>
                                </div>
                                <div onclick="selectService('Bombeo Solar / Rural', 'fa-droplet')" class="p-3.5 hover:bg-indigo-50 cursor-pointer flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700 transition-colors">
                                    <i class="fa-solid fa-droplet text-indigo-600 w-5 text-center"></i>
                                    <span>Bombeo Solar / Rural</span>
                                </div>
                                <div onclick="selectService('Agua Caliente', 'fa-thermometer')" class="p-3.5 hover:bg-indigo-50 cursor-pointer flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700 transition-colors">
                                    <i class="fa-solid fa-thermometer text-indigo-600 w-5 text-center"></i>
                                    <span>Agua Caliente</span>
                                </div>
                                <div onclick="selectService('Otro Servicio', 'fa-ellipsis')" class="p-3.5 hover:bg-indigo-50 cursor-pointer flex items-center gap-3 text-xs sm:text-sm font-medium text-slate-700 transition-colors">
                                    <i class="fa-solid fa-ellipsis text-indigo-600 w-5 text-center"></i>
                                    <span>Otro Servicio</span>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label for="comment" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Comentario o Consulta <span class="text-red-500">*</span>
                            </label>
                            <textarea id="comment" rows="3" placeholder="Escribe tu mensaje o detalles de lo que necesitas..." oninput="validateField(this)" onblur="validateField(this)"
                                class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white text-sm transition-all duration-200 resize-none"></textarea>
                        </div>

                        <div>
                            <button type="submit" id="submit-btn"
                                class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-lg shadow-indigo-600/25 hover:shadow-indigo-600/40 active:scale-[0.99] transition-all duration-200 flex items-center justify-center gap-2 group cursor-pointer">
                                <span>Enviar Mensaje</span>
                                <i class="fa-solid fa-paper-plane text-sm group-hover:translate-x-1 transition-transform"></i>
                            </button>
                        </div>
                    </form>
                </section>

                <!-- Bottom Side: Direct Links -->
                <section class="p-6 sm:p-8 lg:p-10 bg-slate-50/70 dark:bg-slate-800/50 border-t border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row gap-4 justify-between">
                    
                    <!-- Direct WhatsApp Button -->
                    <a href="https://wa.me/5492922480475" target="_blank"
                        class="w-full bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 text-white font-medium p-4 rounded-2xl shadow-md shadow-emerald-500/20 transition-all flex items-center justify-between group cursor-pointer">
                        <div class="flex items-center gap-3.5">
                            <div class="w-11 h-11 rounded-xl bg-white/20 flex items-center justify-center text-2xl shrink-0">
                                <i class="fa-brands fa-whatsapp"></i>
                            </div>
                            <div class="text-left">
                                <p class="text-xs text-emerald-100 font-normal">Enviar WhatsApp a</p>
                                <p class="text-base font-bold leading-tight">+54 9 2922 480475</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-arrow-up-right-from-square text-sm text-emerald-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform shrink-0"></i>
                    </a>

                    <!-- Direct Email Button -->
                    <a href="mailto:nicoburgos4@gmail.com"
                        class="w-full bg-slate-800 hover:bg-slate-900 active:bg-black text-white font-medium p-4 rounded-2xl shadow-md shadow-slate-800/10 transition-all flex items-center justify-between group cursor-pointer">
                        <div class="flex items-center gap-3.5">
                            <div class="w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center text-2xl shrink-0">
                                <i class="fa-regular fa-envelope"></i>
                            </div>
                            <div class="text-left">
                                <p class="text-xs text-slate-400 font-normal">Enviar correo a</p>
                                <p class="text-base font-bold leading-tight">nicoburgos4@gmail.com</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-arrow-up-right-from-square text-sm text-slate-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform shrink-0"></i>
                    </a>

                </section>
            </div>
        </div>
    </div>
</section>

<!-- Divisor inferior de sección -->
<div class="relative w-full h-12 md:h-24 bg-white dark:bg-[#020618] rounded-[0_0_100%_100%] shadow-[0_10px_30px_rgba(255,159,0,0.15)] dark:shadow-[0_10px_30px_rgba(255,159,0,0.2)] transition-colors z-20"></div>

<!-- Modals outside section to avoid z-index/overflow clipping -->
<div id="success-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] flex items-center justify-center p-4 hidden transition-opacity duration-300">
    <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-2xl text-center border border-slate-100 transform scale-95 transition-transform duration-300" id="modal-card">
        <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-2xl mb-4">
            <i class="fa-solid fa-check"></i>
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">¡Datos Completados!</h3>
        <p class="text-slate-600 text-sm mb-6" id="modal-message">
            Hemos organizado tu consulta. Elige por qué medio deseas enviarla:
        </p>

        <div class="space-y-3">
            <button onclick="confirmSendWhatsApp()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3 px-4 rounded-xl shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i class="fa-brands fa-whatsapp text-lg"></i>
                <span>Enviar datos por WhatsApp</span>
            </button>

            <button onclick="confirmSendEmail()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 px-4 rounded-xl shadow-md shadow-indigo-600/20 transition-all flex items-center justify-center gap-2 cursor-pointer">
                <i class="fa-regular fa-envelope text-lg"></i>
                <span>Enviar datos por Correo</span>
            </button>

            <button onclick="closeModal()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium py-2.5 px-4 rounded-xl transition-all text-xs cursor-pointer">
                Cerrar ventana
            </button>
        </div>
    </div>
</div>

<div id="toast" class="fixed bottom-5 right-5 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300 z-[100] text-xs font-medium border border-slate-700 pointer-events-none">
    <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
    <span id="toast-message">Notificación</span>
</div>

<script is:inline>
    const DESTINATION_PHONE = "5492922480475"; // Zenit Solar Phone
    const DESTINATION_EMAIL = "nicoburgos4@gmail.com"; // Zenit Solar Email

    function toggleServiceDropdown() {
        const menu = document.getElementById('service-menu');
        const arrow = document.getElementById('dropdown-arrow');
        menu.classList.toggle('hidden');
        arrow.classList.toggle('rotate-180');
    }

    function selectService(serviceName, iconClass) {
        document.getElementById('selected-service').value = serviceName;
        document.getElementById('selected-service-text').innerHTML = `<i class="fa-solid ${iconClass} text-indigo-600"></i> ${serviceName}`;
        toggleServiceDropdown();
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const dropdownBtn = document.getElementById('service-dropdown-btn');
        const menu = document.getElementById('service-menu');
        if (dropdownBtn && menu && !dropdownBtn.contains(event.target) && !menu.contains(event.target)) {
            menu.classList.add('hidden');
            const arrow = document.getElementById('dropdown-arrow');
            if(arrow) arrow.classList.remove('rotate-180');
        }
    });

    function buildFormattedMessage() {
        const firstName = document.getElementById('first-name').value.trim();
        const lastName = document.getElementById('last-name').value.trim();
        const email = document.getElementById('email').value.trim();
        const phoneInput = document.getElementById('phone');
        const cleanPhone = phoneInput.dataset.cleanNumber || phoneInput.value.replace(/\D/g, '');
        const phone = cleanPhone.length === 10 ? `+54 9 ${cleanPhone}` : phoneInput.value.trim();
        const service = document.getElementById('selected-service').value;
        const comment = document.getElementById('comment').value.trim();

        return {
            firstName,
            fullName: `${firstName} ${lastName}`,
            email,
            phone,
            service,
            comment,
            text: `*Hola! Consulta desde la web Zenit Solar:*
- *Nombre:* ${firstName} ${lastName}
- *Correo:* ${email}
- *Teléfono:* ${phone}
- *Servicio:* ${service}
- *Mensaje:* ${comment}`
        };
    }

    function validateField(input) {
        if (!input) return false;
        
        let isValid = false;
        const val = input.value.trim();

        if (input.id === 'phone') {
            const errorEl = document.getElementById('phone-error');
            const hintEl = document.getElementById('phone-hint');
            let phoneErrorMsg = '';
            
            if (val === '') {
                isValid = false;
            } else {
                let digits = val.replace(/\D/g, '');

                // Extraer código de país +549 o +54
                if (digits.startsWith('549') && digits.length >= 13) {
                    digits = digits.slice(3);
                } else if (digits.startsWith('54') && digits.length >= 12) {
                    digits = digits.slice(2);
                }
                
                // Extraer prefijo 0 (llamadas nacionales)
                if (digits.startsWith('0')) {
                    digits = digits.slice(1);
                }

                // Extraer 9 de celular si lo pusieron sin el 54
                if (digits.length === 11 && digits.startsWith('9')) {
                    digits = digits.slice(1);
                }

                // Detectar y extraer el "15" (solo si es la longitud correcta de 12 dígitos en total)
                if (digits.length === 12) {
                    // Códigos de área oficiales: 11, 2xx, 3xx, 2xxx, 3xxx
                    const match = digits.match(/^(11|2\d{2,3}|3\d{2,3})15(\d{6,8})$/);
                    if (match && match[1].length + match[2].length === 10) {
                        digits = match[1] + match[2]; // quitamos el 15
                    }
                }

                // Guardar número limpio para el envío final
                input.dataset.cleanNumber = digits;

                // Validación final de longitud y código de área
                if (digits.length < 10) {
                    isValid = false;
                    phoneErrorMsg = 'El número parece estar incompleto.';
                } else if (digits.length > 10) {
                    isValid = false;
                    phoneErrorMsg = 'El número tiene demasiados dígitos.';
                } else {
                    // Exactamente 10 dígitos. Validar que el código de área exista en Argentina
                    const validAreaCodeRegex = /^(11|2\d{2,3}|3\d{2,3})/;
                    if (!validAreaCodeRegex.test(digits)) {
                        isValid = false;
                        phoneErrorMsg = 'El código de área no parece válido.';
                    } else {
                        isValid = true;
                    }
                }
            }
            
            if (!isValid && val !== '') {
                errorEl.innerText = phoneErrorMsg;
                errorEl.classList.remove('hidden');
                hintEl.classList.add('hidden');
            } else {
                errorEl.classList.add('hidden');
                hintEl.classList.remove('hidden');
            }

        } else if (val === '') {
            isValid = false;
        } else if (input.type === 'email') {
            isValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
        } else {
            isValid = true;
        }

        // Limpiar clases previas de bordes y focos
        input.classList.remove('border-slate-200', 'border-red-500', 'border-green-500', 'focus:ring-indigo-500', 'focus:ring-red-500', 'focus:ring-green-500');

        if (isValid) {
            input.classList.add('border-green-500', 'focus:ring-green-500');
        } else {
            input.classList.add('border-red-500', 'focus:ring-red-500');
        }
        
        return isValid;
    }

    function handleFormSubmit(e) {
        e.preventDefault();

        // Validar todos los campos
        const inputs = [
            document.getElementById('first-name'),
            document.getElementById('last-name'),
            document.getElementById('email'),
            document.getElementById('phone'),
            document.getElementById('comment')
        ];
        
        let allValid = true;
        inputs.forEach(input => {
            if (!validateField(input)) {
                allValid = false;
            }
        });

        if (!allValid) {
            showErrorToast('Por favor completa los campos marcados en rojo.');
            return;
        }

        const data = buildFormattedMessage();
        document.getElementById('modal-message').innerText = 
            `Hola ${data.firstName}, hemos guardado tus datos para el servicio "${data.service}". Selecciona cómo deseas enviarlo:`;
        openModal();
    }

    function confirmSendWhatsApp() {
        const data = buildFormattedMessage();
        const encoded = encodeURIComponent(data.text);
        window.open(`https://wa.me/${DESTINATION_PHONE}?text=${encoded}`, '_blank');
        closeModal();
        showToast('Redirigiendo a WhatsApp...');
    }

    function confirmSendEmail() {
        const data = buildFormattedMessage();
        const subject = `Consulta web Zenit Solar: ${data.service} - ${data.fullName}`;
        const body = `Nombre: ${data.fullName}\nEmail: ${data.email}\nTeléfono: ${data.phone}\nServicio: ${data.service}\n\nMensaje:\n${data.comment}`;
        window.location.href = `mailto:${DESTINATION_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        closeModal();
        showToast('Abriendo tu app de correo...');
    }

    function showToast(message) {
        const toast = document.getElementById('toast');
        const icon = toast.querySelector('i');
        
        // Configuración para éxito por defecto
        icon.className = 'fa-solid fa-circle-check text-emerald-400 text-base';
        document.getElementById('toast-message').innerText = message;
        
        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-20', 'opacity-0');
        }, 3000);
    }

    function showErrorToast(message) {
        const toast = document.getElementById('toast');
        const icon = toast.querySelector('i');
        
        // Configuración para error
        icon.className = 'fa-solid fa-circle-exclamation text-red-400 text-base';
        document.getElementById('toast-message').innerText = message;
        
        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-20', 'opacity-0');
            
            // Resetear icono para futuros toasts
            setTimeout(() => {
                icon.className = 'fa-solid fa-circle-check text-emerald-400 text-base';
            }, 300);
        }, 3000);
    }

    function openModal() {
        const modal = document.getElementById('success-modal');
        const card = document.getElementById('modal-card');
        modal.classList.remove('hidden');
        setTimeout(() => {
            card.classList.remove('scale-95');
            card.classList.add('scale-100');
        }, 10);
    }

    function closeModal() {
        const modal = document.getElementById('success-modal');
        const card = document.getElementById('modal-card');
        card.classList.remove('scale-100');
        card.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }
</script>