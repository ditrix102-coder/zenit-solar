---
---
<section id="inicio" class="pt-32 pb-16 lg:pt-24 lg:pb-16 lg:min-h-screen max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center overflow-x-hidden">
    
    <div class="space-y-6 relative" id="hero-content-area">
        <h1 data-aos="fade-up" class="text-4xl md:text-5xl lg:text-[56px] font-extrabold text-dark dark:text-white leading-[1.15] tracking-tight transition-colors">
            Llevamos energía <br>
            <span class="text-[#d97706] dark:text-primary">a donde la necesites</span>
        </h1>
        
        <p data-aos="fade-up" data-aos-delay="100" class="text-base md:text-lg text-gray-500 dark:text-gray-400 max-w-lg leading-relaxed transition-colors">
            En <strong class="text-dark dark:text-white">Zenit Solar</strong> ofrecemos soluciones fotovoltaicas integrales para hogares, comercios, industrias y el campo. 
            Diseñamos, instalamos y mantenemos sistemas de energía solar de alta eficiencia, ayudándote a reducir costos y cuidar el planeta.
        </p>
        
        <div data-aos="fade-up" data-aos-delay="200" class="flex flex-wrap gap-4 pt-2">
            <a href="#contacto" class="bg-primary text-slate-900 px-7 py-3.5 rounded-xl text-[15px] font-medium hover:bg-primary-hover flex items-center gap-2 transition-all shadow-md shadow-primary/20">
                Solicitar cotización <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
            <a href="#soluciones" class="bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-dark dark:text-white px-7 py-3.5 rounded-xl text-[15px] font-medium hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors shadow-sm">
                Conocé más
            </a>
        </div>
    </div>
    
    <div class="relative w-full max-w-lg mx-auto lg:max-w-none mt-8 lg:mt-0" data-aos="fade-left" data-aos-delay="200">
        <!-- Carousel -->
        <div class="relative rounded-[2rem] shadow-2xl w-full aspect-[4/3] sm:aspect-video lg:aspect-auto lg:h-[65vh] lg:min-h-[450px] lg:max-h-[650px] overflow-hidden group">
            <!-- Ticker superior superpuesto en la imagen -->
            <div class="absolute top-0 inset-x-0 z-30 w-full overflow-hidden bg-slate-900/60 backdrop-blur-md border-b border-white/10 py-3">
                <!-- Fade edges para el ticker oscuro -->
                <div class="absolute inset-y-0 left-0 w-12 bg-gradient-to-r from-slate-900/80 to-transparent z-10"></div>
                <div class="absolute inset-y-0 right-0 w-12 bg-gradient-to-l from-slate-900/80 to-transparent z-10"></div>
                
                <div class="flex w-max animate-ticker gap-16 px-12">
                    <!-- Set 1 -->
                    <div class="flex items-center gap-2.5">
                        <i data-lucide="sun" class="w-4 h-4 text-amber-500"></i>
                        <p class="text-[14px] font-bold text-white whitespace-nowrap">Energía Solar <span class="text-slate-300 font-normal">100% renovable</span></p>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <i data-lucide="zap" class="w-4 h-4 text-amber-500"></i>
                        <p class="text-[14px] font-bold text-white whitespace-nowrap">Ahorro garantizado <span class="text-slate-300 font-normal">hasta 80%</span></p>
                    </div>
                    <!-- Set 2 -->
                    <div class="flex items-center gap-2.5">
                        <i data-lucide="sun" class="w-4 h-4 text-amber-500"></i>
                        <p class="text-[14px] font-bold text-white whitespace-nowrap">Energía Solar <span class="text-slate-300 font-normal">100% renovable</span></p>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <i data-lucide="zap" class="w-4 h-4 text-amber-500"></i>
                        <p class="text-[14px] font-bold text-white whitespace-nowrap">Ahorro garantizado <span class="text-slate-300 font-normal">hasta 80%</span></p>
                    </div>
                </div>
            </div>

            <img src="/images/carrusel1.webp" class="hero-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out opacity-100 z-0" alt="Instalación de paneles solares 1" fetchpriority="high" decoding="async">
            <img src="/images/carrusel2.webp" class="hero-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out opacity-0 z-0" alt="Instalación de paneles solares 2" loading="lazy" decoding="async">
            <img src="/images/carrusel3.webp" class="hero-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ease-in-out opacity-0 z-0" alt="Instalación de paneles solares 3" loading="lazy" decoding="async">
            
            <!-- Controles (Puntos) -->
            <div class="absolute bottom-6 left-0 right-0 flex justify-center gap-3 z-20">
                <button aria-label="Ver imagen 1" class="hero-dot w-3 h-3 rounded-full bg-primary transition-colors duration-300 shadow-sm"></button>
                <button aria-label="Ver imagen 2" class="hero-dot w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors duration-300 shadow-sm"></button>
                <button aria-label="Ver imagen 3" class="hero-dot w-3 h-3 rounded-full bg-white/50 hover:bg-white/80 transition-colors duration-300 shadow-sm"></button>
            </div>
            
            <!-- Overlay gradiente muy sutil para mejorar legibilidad de botones si hay fondos claros -->
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/40 to-transparent pointer-events-none z-10"></div>
        </div>
        
        </div>
    </div>
</section>

<style>
    @keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-12px); }
        100% { transform: translateY(0px); }
    }
    .animate-float {
        animation: float 5s ease-in-out infinite;
    }
    .animate-float-delayed {
        animation: float 6s ease-in-out 2.5s infinite;
    }
    @keyframes ticker {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .animate-ticker {
        animation: ticker 12s linear infinite;
    }
    .animate-ticker:hover {
        animation-play-state: paused;
    }
</style>

<script>
    function initHeroCarousel() {
        const slides = document.querySelectorAll('.hero-slide');
        const dots = document.querySelectorAll('.hero-dot');
        let currentSlide = 0;
        let interval;

        if (slides.length === 0) return;

        function showSlide(index) {
            slides.forEach((slide, i) => {
                if (i === index) {
                    slide.classList.remove('opacity-0');
                    slide.classList.add('opacity-100');
                    dots[i].classList.remove('bg-white/50');
                    dots[i].classList.add('bg-primary');
                } else {
                    slide.classList.remove('opacity-100');
                    slide.classList.add('opacity-0');
                    dots[i].classList.remove('bg-primary');
                    dots[i].classList.add('bg-white/50');
                }
            });
            currentSlide = index;
        }

        function nextSlide() {
            showSlide((currentSlide + 1) % slides.length);
        }

        // Auto play
        interval = setInterval(nextSlide, 5000);

        // Controles manuales
        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                clearInterval(interval);
                showSlide(index);
                interval = setInterval(nextSlide, 5000);
            });
        });
    }

    document.addEventListener('DOMContentLoaded', initHeroCarousel);
    document.addEventListener('astro:page-load', initHeroCarousel);
</script>

</script>