---
---
<section id="como-funciona" class="bg-slate-50 dark:bg-slate-900/20 py-10 border-t border-gray-100 dark:border-slate-800 transition-colors">
  <!-- Header -->
  <div class="sticky-scroller__filler-content">
    <h2 data-aos="fade-up" class="text-3xl md:text-4xl font-bold text-dark dark:text-white mb-4 transition-colors">
      Cómo funciona nuestro <span class="text-primary">Servicio</span>
    </h2>
    <p data-aos="fade-up" data-aos-delay="100" class="text-base text-gray-500 dark:text-gray-400">
      Descubrí el paso a paso hacia la energía limpia
    </p>
  </div>

  <!-- Sticky Scroller -->
  <div class="sticky-scroller max-w-7xl mx-auto">
    <!-- Images -->
    <div class="sticky-scroller__images">
      <!-- Image 1 -->
      <div class="sticky-scroller__image" id="image1">
        <img src="https://images.unsplash.com/photo-1593941707882-a5bba14938c7?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Asesoramiento y Diseño" class="rounded-3xl shadow-2xl w-[450px] h-[450px] object-cover">
      </div>
      <!-- Image 2 -->
      <div class="sticky-scroller__image is-hidden" id="image2">
        <img src="https://images.unsplash.com/photo-1509391366360-2e959784a276?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Instalación" class="rounded-3xl shadow-2xl w-[450px] h-[450px] object-cover">
      </div>
      <!-- Image 3 -->
      <div class="sticky-scroller__image is-hidden" id="image3">
        <img src="https://images.unsplash.com/photo-1497435334941-8c899ee9e8e9?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Ahorro y Monitoreo" class="rounded-3xl shadow-2xl w-[450px] h-[450px] object-cover">
      </div>
    </div>

    <!-- Content -->
    <div class="sticky-scroller__content px-4 sm:px-6 lg:px-8">
      <!-- Section 1 -->
      <div class="sticky-scroller__section" data-section-number="1">
        <div class="sticky-scoller__section-content max-w-xl mx-auto lg:mx-0">
          <div class="sticky-scroller__image--mobile">
            <img src="https://images.unsplash.com/photo-1593941707882-a5bba14938c7?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Asesoramiento" class="rounded-2xl shadow-lg w-full h-[250px] sm:h-[350px] object-cover">
          </div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 shrink-0 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xl border border-primary/20 shadow-[0_0_15px_rgba(255,159,0,0.2)]">1</div>
            <h3 class="text-2xl sm:text-3xl font-bold text-dark dark:text-white">Asesoramiento y Diseño</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400 mb-4 text-lg">Realizamos un estudio de viabilidad de tus consumos eléctricos para dimensionar el equipo fotovoltaico que mejor se adapte a tus necesidades específicas.</p>
          <p class="text-gray-600 dark:text-gray-400 text-lg">Te presentamos una propuesta técnica y comercial clara, llave en mano, sin sorpresas ni costos ocultos para que tomes la mejor decisión.</p>
        </div>
      </div>
      
      <!-- Section 2 -->
      <div class="sticky-scroller__section" data-section-number="2">
        <div class="sticky-scoller__section-content max-w-xl mx-auto lg:mx-0">
          <div class="sticky-scroller__image--mobile">
            <img src="https://images.unsplash.com/photo-1509391366360-2e959784a276?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Instalación" class="rounded-2xl shadow-lg w-full h-[250px] sm:h-[350px] object-cover">
          </div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 shrink-0 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xl border border-primary/20 shadow-[0_0_15px_rgba(255,159,0,0.2)]">2</div>
            <h3 class="text-2xl sm:text-3xl font-bold text-dark dark:text-white">Instalación Profesional</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400 mb-4 text-lg">Nuestro equipo técnico certificado se encarga del montaje de los paneles solares, inversores, baterías y la puesta en marcha del sistema integral.</p>
          <p class="text-gray-600 dark:text-gray-400 text-lg">Trabajamos con los más altos estándares de seguridad y eficiencia en tiempo récord, dejándolo 100% operativo y listo para generar energía.</p>
        </div>
      </div>
      
      <!-- Section 3 -->
      <div class="sticky-scroller__section" data-section-number="3">
        <div class="sticky-scoller__section-content max-w-xl mx-auto lg:mx-0">
          <div class="sticky-scroller__image--mobile">
            <img src="https://images.unsplash.com/photo-1497435334941-8c899ee9e8e9?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Ahorro" class="rounded-2xl shadow-lg w-full h-[250px] sm:h-[350px] object-cover">
          </div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 shrink-0 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xl border border-primary/20 shadow-[0_0_15px_rgba(255,159,0,0.2)]">3</div>
            <h3 class="text-2xl sm:text-3xl font-bold text-dark dark:text-white">Ahorro y Monitoreo</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400 mb-4 text-lg">Comenzá a generar tu propia energía de inmediato y reducí drásticamente el valor mensual de tu factura de luz desde el primer día.</p>
          <p class="text-gray-600 dark:text-gray-400 text-lg">A través de una aplicación móvil intuitiva, vas a poder monitorear en tiempo real cuánto produce, consume y ahorra tu sistema solar estés donde estés.</p>
        </div>
      </div>
    </div>
  </div>
  
  <div class="sticky-scroller__filler-content pb-10">
    <a href="#contacto" class="bg-primary text-slate-900 px-8 py-4 rounded-xl text-[16px] font-semibold hover:bg-primary/90 transition-all shadow-lg hover:shadow-xl hover:-translate-y-1 mt-4">
      Comenzar mi proyecto solar
    </a>
  </div>
</section>

<style>
/* Filler Content - Removed original pink background to match theme */
.sticky-scroller__filler-content {
  align-items: center;
  display: flex;
  flex-direction: column;
  padding: 4rem 0;
  justify-content: center;
  text-align: center;
}

/* Sticky Scroller */
.sticky-scroller {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
}

.sticky-scroller__images {
  align-items: center;
  display: none;
  height: 100vh;
  opacity: 0;
  justify-content: center;
  position: sticky;
  top: 0;
  transform: scale(1);
  visibility: hidden;
  width: 100%;
}

.sticky-scroller__image {
  position: absolute;
  transition: opacity 0.5s ease-in-out, transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.sticky-scroller__image.is-hidden {
  opacity: 0;
  transform: scale(0.85);
  visibility: hidden;
}

.sticky-scroller__image--mobile {
  align-items: center;
  display: flex;
  justify-content: center;
  margin-bottom: 2rem;
}

.sticky-scroller__section {
  align-items: center;
  display: flex;
  margin: 0;
  padding: 3rem 0;
  width: 100%;
}

@media (max-width: 1023px) {
  .sticky-scroller__content {
    padding-bottom: 2rem;
  }
  .sticky-scroller__section {
    position: sticky;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 28px;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 -8px 25px -5px rgba(0,0,0,0.05);
    transition: transform 0.4s cubic-bezier(0.76, 0, 0.24, 1);
    transform-origin: top center;
  }
  
  :global(.dark) .sticky-scroller__section {
    background: #0f172a;
    border-color: #1e293b;
    box-shadow: 0 -8px 25px -5px rgba(0,0,0,0.3);
  }

  .sticky-scroller__section[data-section-number="1"] { top: 90px; z-index: 10; }
  .sticky-scroller__section[data-section-number="2"] { top: 110px; z-index: 20; }
  .sticky-scroller__section[data-section-number="3"] { top: 130px; z-index: 30; }
}

/* Make responsive */
@media (min-width: 1024px) {
  .sticky-scroller__images {
    display: flex;
    opacity: 1;
    visibility: visible;
    width: 50%;
  }
  
  .sticky-scroller__content {
    width: 50%;
    padding-right: 2rem;
  }  
  
  .sticky-scroller__image--mobile {
    display: none;
    opacity: 0;
    visibility: hidden;
  }
  
  .sticky-scroller__section {
    height: 100vh; 
    margin: 0;
    padding: 0;
    border-bottom: none !important;
  }
}
</style>

<script>
// Intersection observer
function createIntersectionObserver(
  callback, 
  opts = { 
    root: null, // viewport
    rootMargin: '0px', 
    threshold: 0.5 // at 50% visible
  }) {
    var previousY = new Map();
    var observer = new IntersectionObserver(function(entries, observer) {
      entries.forEach(function (entry) {
        var currY = entry.boundingClientRect.y;
        var prevY = previousY.get(entry.target) || 0;
        if ( currY < prevY ) { entry.scrollDirectionY = 'down'; }
        if ( currY > prevY ) { entry.scrollDirectionY = 'up'; }
        callback(entry, observer, entries);
        previousY.set(entry.target, currY);
      });
    }, opts)
  
    return observer;
}

function initStickyScroller() {
    var observer = createIntersectionObserver(function(entry){
        const sectionNumber = entry.target.dataset.sectionNumber;
        if (!sectionNumber) return;
        const sectionImage = document.getElementById('image' + sectionNumber);
        if (!sectionImage) return;

        if (entry.isIntersecting) {
            sectionImage.classList.remove('is-hidden');
        }
        else {
            sectionImage.classList.add('is-hidden');
            if ((sectionNumber === "1") && (entry.scrollDirectionY === 'up')) { 
                // scrolling up past first section
                sectionImage.classList.remove('is-hidden');
            } else if ((sectionNumber === "3") && (entry.scrollDirectionY === 'down')) { 
                // scrolling down past last section
                sectionImage.classList.remove('is-hidden');
            } else {
                sectionImage.classList.add('is-hidden');
            }
        }
    });
    
    document.querySelectorAll('.sticky-scroller__section').forEach(function(el) { 
        observer.observe(el); 
    });
}

// Run on initial load and view transitions
document.addEventListener('DOMContentLoaded', initStickyScroller);
document.addEventListener('astro:page-load', initStickyScroller);
</script>
